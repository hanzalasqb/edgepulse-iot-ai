ENVIRONMENT=development
DATABASE_URL=sqlite:///./edgepulse.db
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32
# OpenAI-compatible LLM with tool calling (OpenAI, Groq, Together, Ollama at http://localhost:11434/v1)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-key
LLM_MODEL=gpt-4o-mini
# MQTT broker (leave empty to use HTTP ingestion only)
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
# Create demo devices on first start and print their API keys
SEED_DEMO_DEVICES=true
OFFLINE_AFTER_SECONDS=30
CORS_ORIGINS=http://localhost:5173
